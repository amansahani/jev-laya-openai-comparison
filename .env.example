# TypeSafe Jev API Key (from https://typesafe.ai)
JEV_API_KEY=your_typesafe_api_key_here

# OpenAI API Key (from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Path to local Laya model weights or HuggingFace checkpoint
LAYA_MODEL_PATH=convaiinnovations/laya

# Optional: Path to local GLiNER2.5-Decide model weights or HuggingFace checkpoint
GLINER_MODEL_PATH=fastino/GLiNER2.5-Decide
